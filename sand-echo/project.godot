; 沙之回响 Echoes of Sand — Godot 4.6 工程配置
; Godot 大版本：4.6（实测版本 4.6.2.stable.official）
config_version=5

[application]

config/name="沙之回响 Echoes of Sand"
config/description="沙漠像素风俯视角 2D 弹幕射击 Roguelike。完全开源（MIT）。"
config/version="0.3.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.086, 0.067, 0.11, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

RunState="*res://autoload/run_state.gd"
MetaProgress="*res://autoload/meta_progress.gd"
EventBus="*res://autoload/event_bus.gd"
Sfx="*res://autoload/sfx.gd"

[debug]

gdscript/warnings/unused_parameter=1
gdscript/warnings/unused_variable=1
gdscript/warnings/shadowed_variable=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

